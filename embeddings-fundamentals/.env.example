# Copy to .env (git-ignored). Never commit a real key.

# Read only for engine = "openai" on a corpus with remote_allowed = true.
OPENAI_API_KEY=

# Exam-type classifier (spec/CLASSIFIER.md §12): TypeSafe's Jev. Read only when sending is
# authorized; RLCD_API_KEY, if set and not empty, takes precedence.
TYPESAFE_API_KEY=
# Optional; the defaults are shown.
# RLCD_MODEL=jev-1.13.0
# RLCD_BASE_URL=https://api.typesafe.ai
# RLCD_TIMEOUT_S=20.0

# CLASSIFIER_REMOTE_ALLOWED is never read from this file: set it in the command itself,
# for the one run that may send (CLASSIFIER_REMOTE_ALLOWED=1 ... classify --enviar).

# Owner's sample exams in Cloudflare R2 (scripts/fetch-sample-exams.sh): an account API
# token with R2 read access, and the account id.
R2_API_KEY=
R2_ACCOUNT_ID=
